generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios    User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  roleId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         Role     @relation(fields: [roleId], references: [id])
  visitas      Visita[]
  reportes     Reporte[]

  @@map("usuarios")
}

model Cliente {
  id               Int       @id @default(autoincrement())
  nombre           String
  rtn              String?   @unique
  contactoNombre   String?
  telefono         String?
  correo           String?
  direccion        String?
  ubicacion        String?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maquinas         Maquina[]
  ordenesServicio  OrdenServicio[]
  visitas          Visita[]
  reportes         Reporte[]

  @@map("clientes")
}

model Maquina {
  id                Int       @id @default(autoincrement())
  clienteId         Int
  codigoInterno     String?
  nombreEquipo      String
  tipoEquipo        String?
  marca             String?
  modelo            String?
  serie             String?
  refrigerante      String?
  cargaRefrigerante String?
  ubicacion         String?
  area              String?
  observaciones     String?
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cliente           Cliente   @relation(fields: [clienteId], references: [id])
  visitas           VisitaMaquina[]
  reportesDetalle   ReporteDetalleMaquina[]

  @@map("maquinas")
}

model OrdenServicio {
  id                  Int       @id @default(autoincrement())
  clienteId           Int
  numeroOrden         String    @unique
  contactoNombre      String?
  telefonoContacto    String?
  correoContacto      String?
  ubicacionServicio   String?
  prioridad           String?
  tipoSolicitud       String?
  origenSolicitud     String?
  descripcionProblema String
  estado              String    @default("nueva")
  fechaSolicitud      DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cliente             Cliente   @relation(fields: [clienteId], references: [id])
  visitas             Visita[]

  @@map("ordenes_servicio")
}

model Visita {
  id                 Int       @id @default(autoincrement())
  ordenServicioId    Int?
  clienteId          Int
  tecnicoId          Int
  tipoVisita         String?
  motivoVisita       String?
  resultadoBreve     String?
  estado             String    @default("pendiente")
  requiereCotizacion Boolean   @default(false)
  esVisitaLibre      Boolean   @default(false)
  fechaVisita        DateTime  @default(now())
  horaInicio         DateTime?
  horaFin            DateTime?
  observaciones      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ordenServicio      OrdenServicio? @relation(fields: [ordenServicioId], references: [id])
  cliente            Cliente        @relation(fields: [clienteId], references: [id])
  tecnico            User           @relation(fields: [tecnicoId], references: [id])
  maquinas           VisitaMaquina[]
  reportes           Reporte[]

  @@map("visitas")
}

model VisitaMaquina {
  id         Int      @id @default(autoincrement())
  visitaId   Int
  maquinaId  Int
  createdAt  DateTime @default(now())

  visita     Visita   @relation(fields: [visitaId], references: [id])
  maquina    Maquina  @relation(fields: [maquinaId], references: [id])

  @@unique([visitaId, maquinaId])
  @@map("visitas_maquinas")
}

model Reporte {
  id                 Int       @id @default(autoincrement())
  visitaId           Int
  clienteId          Int
  tecnicoId          Int
  numeroReporte      String    @unique
  tipoReporte        String?
  conclusiones       String?
  observaciones      String?
  requiereCotizacion Boolean   @default(false)
  estado             String    @default("borrador")
  urlPdf             String?
  urlCarpetaDrive    String?
  fechaReporte       DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  visita             Visita    @relation(fields: [visitaId], references: [id])
  cliente            Cliente   @relation(fields: [clienteId], references: [id])
  tecnico            User      @relation(fields: [tecnicoId], references: [id])
  detallesMaquinas   ReporteDetalleMaquina[]
  anexos             Anexo[]
  cierre             CierreReporte?

  @@map("reportes")
}

model ReporteDetalleMaquina {
  id               Int       @id @default(autoincrement())
  reporteId        Int
  maquinaId        Int
  procedimiento    String?
  diagnostico      String?
  trabajoRealizado String?
  recomendaciones  String?
  psi              String?
  amperaje         String?
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reporte          Reporte   @relation(fields: [reporteId], references: [id])
  maquina          Maquina   @relation(fields: [maquinaId], references: [id])

  @@map("reportes_detalle_maquinas")
}

model Anexo {
  id            Int       @id @default(autoincrement())
  reporteId     Int?
  tipoArchivo   String?
  nombreArchivo String
  urlArchivo    String
  driveFileId   String?
  mimeType      String?
  tamanoBytes   Int?
  createdAt     DateTime  @default(now())

  reporte       Reporte?  @relation(fields: [reporteId], references: [id])

  @@map("anexos")
}

model CierreReporte {
  id                Int       @id @default(autoincrement())
  reporteId         Int       @unique
  recibido          Boolean   @default(false)
  aprobado          Boolean?
  nombreRecibe      String?
  puestoRecibe      String?
  urlFirma          String?
  motivoNoRecepcion String?
  observaciones     String?
  fechaCierre       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reporte           Reporte   @relation(fields: [reporteId], references: [id])

  @@map("cierres_reporte")
}