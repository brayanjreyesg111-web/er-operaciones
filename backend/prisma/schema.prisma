generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  roleId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role                 Role                @relation(fields: [roleId], references: [id])
  visitas              Visita[]            @relation("VisitaTecnicoPrincipal")
  visitasAsignadas     VisitaAsignado[]
  reportes             Reporte[]
  solicitudesAsignadas SolicitudServicio[] @relation("SolicitudAsignada")
  actividadesCreadas   Actividad[]         @relation("ActividadCreadaPor")
  actividadesAsignadas ActividadAsignado[]
  pasosRealizados      ActividadPaso[]     @relation("PasoRealizadoPor")
  mensajesActividad    ActividadMensaje[]

  @@map("usuarios")
}

model Cliente {
  id             Int      @id @default(autoincrement())
  nombre         String
  rtn            String?  @unique
  contactoNombre String?
  telefono       String?
  correo         String?
  direccion      String?
  ubicacion      String?
  departamentoId Int?
  ciudadId       Int?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  departamento    Departamento?       @relation(fields: [departamentoId], references: [id])
  ciudad          Ciudad?             @relation(fields: [ciudadId], references: [id])
  maquinas        Maquina[]
  ordenesServicio OrdenServicio[]
  visitas         Visita[]
  reportes        Reporte[]
  actividades     Actividad[]
  solicitudes     SolicitudServicio[]

  @@map("clientes")
}

model TipoUnidad {
  id          Int      @id @default(autoincrement())
  codigo      String?  @unique
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maquinas         Maquina[]
  marcasPermitidas MarcaTipoUnidad[]
  reportes         Reporte[]
  detallesReporte  ReporteDetalleMaquina[]

  @@map("tipos_unidad")
}

model Marca {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maquinas        Maquina[]
  tiposPermitidos MarcaTipoUnidad[]

  @@map("marcas")
}

model MarcaTipoUnidad {
  id           Int      @id @default(autoincrement())
  tipoUnidadId Int
  marcaId      Int
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tipoUnidad TipoUnidad @relation(fields: [tipoUnidadId], references: [id])
  marca      Marca      @relation(fields: [marcaId], references: [id])

  @@unique([tipoUnidadId, marcaId])
  @@map("marcas_tipos_unidad")
}

model Refrigerante {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maquinas Maquina[]

  @@map("refrigerantes")
}

model UnidadMedidaCarga {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maquinas Maquina[]

  @@map("unidades_medida_carga")
}

model Departamento {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ciudades    Ciudad[]
  maquinas    Maquina[]
  clientes    Cliente[]
  solicitudes SolicitudServicio[]

  @@map("departamentos")
}

model Ciudad {
  id             Int      @id @default(autoincrement())
  departamentoId Int
  codigo         String   @unique
  nombre         String
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  departamento Departamento        @relation(fields: [departamentoId], references: [id])
  maquinas     Maquina[]
  clientes     Cliente[]
  solicitudes  SolicitudServicio[]

  @@unique([departamentoId, nombre])
  @@map("ciudades")
}

model Procedimiento {
  id                     Int      @id @default(autoincrement())
  codigo                 String   @unique
  nombre                 String
  descripcionCompletaPdf String?
  activo                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  reportes        Reporte[]
  detallesReporte ReporteDetalleMaquina[]

  @@map("procedimientos")
}

model HallazgoCatalogo {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  categoria   String
  descripcion String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  detallesReporte ReporteDetalleHallazgo[]

  @@map("hallazgos_catalogo")
}

model Maquina {
  id                        Int      @id @default(autoincrement())
  clienteId                 Int
  tipoUnidadId              Int?
  marcaId                   Int?
  refrigeranteId            Int?
  unidadMedidaCargaId       Int?
  departamentoId            Int?
  ciudadId                  Int?
  codigoInterno             String?  @unique
  tipoEquipo                String?
  marca                     String?
  modelo                    String?
  serie                     String?
  cargaRefrigeranteCantidad Decimal? @db.Decimal(10, 2)
  direccionExacta           String?
  area                      String?
  observaciones             String?
  activo                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  cliente              Cliente            @relation(fields: [clienteId], references: [id])
  tipoUnidad           TipoUnidad?        @relation(fields: [tipoUnidadId], references: [id])
  marcaCatalogo        Marca?             @relation(fields: [marcaId], references: [id])
  refrigeranteCatalogo Refrigerante?      @relation(fields: [refrigeranteId], references: [id])
  unidadMedidaCarga    UnidadMedidaCarga? @relation(fields: [unidadMedidaCargaId], references: [id])
  departamento         Departamento?      @relation(fields: [departamentoId], references: [id])
  ciudad               Ciudad?            @relation(fields: [ciudadId], references: [id])

  visitas          VisitaMaquina[]
  reportesDetalle  ReporteDetalleMaquina[]
  reportesCabecera Reporte[]               @relation("ReporteMaquinaCabecera")
  actividades      ActividadMaquina[]

  @@map("maquinas")
}

model OrdenServicio {
  id                  Int      @id @default(autoincrement())
  clienteId           Int
  numeroOrden         String   @unique
  contactoNombre      String?
  telefonoContacto    String?
  correoContacto      String?
  ubicacionServicio   String?
  prioridad           String?
  tipoSolicitud       String?
  origenSolicitud     String?
  descripcionProblema String
  estado              String   @default("nueva")
  fechaSolicitud      DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  visitas     Visita[]
  actividades Actividad[]

  @@map("ordenes_servicio")
}

model SolicitudServicio {
  id                Int       @id @default(autoincrement())
  clienteId         Int?
  nombreSolicitante String
  telefono          String
  correo            String?
  empresa           String?
  departamentoId    Int
  ciudadId          Int
  direccionExacta   String?
  tipoServicio      String?
  descripcion       String
  estado            String    @default("NUEVA")
  motivoEstado      String?
  canalOrigen       String    @default("PORTAL_WEB")
  fechaDeseada      DateTime?
  fechaGestion      DateTime?
  asignadoAUserId   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cliente      Cliente?     @relation(fields: [clienteId], references: [id])
  departamento Departamento @relation(fields: [departamentoId], references: [id])
  ciudad       Ciudad       @relation(fields: [ciudadId], references: [id])
  asignadoA    User?        @relation("SolicitudAsignada", fields: [asignadoAUserId], references: [id])
  actividades  Actividad[]

  @@map("solicitudes_servicio")
}

model Actividad {
  id                 Int       @id @default(autoincrement())
  codigoActividad    String    @unique
  titulo             String
  descripcion        String?
  categoriaActividad String
  tipoOrigen         String
  clienteId          Int?
  ordenServicioId    Int?
  solicitudId        Int?
  prioridad          String    @default("MEDIA")
  estado             String    @default("PENDIENTE")
  fechaProgramada    DateTime?
  fechaInicio        DateTime?
  fechaFin           DateTime?
  progresoPorcentaje Int       @default(0)
  requiereReporte    Boolean   @default(false)
  requiereVisita     Boolean   @default(false)
  creadoPorId        Int
  observaciones      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cliente       Cliente?           @relation(fields: [clienteId], references: [id])
  ordenServicio OrdenServicio?     @relation(fields: [ordenServicioId], references: [id])
  solicitud     SolicitudServicio? @relation(fields: [solicitudId], references: [id])
  creadoPor     User               @relation("ActividadCreadaPor", fields: [creadoPorId], references: [id])

  visitas   Visita[]
  asignados ActividadAsignado[]
  maquinas  ActividadMaquina[]
  pasos     ActividadPaso[]
  mensajes  ActividadMensaje[]

  @@map("actividades")
}

model ActividadAsignado {
  id               Int      @id @default(autoincrement())
  actividadId      Int
  usuarioId        Int
  rolEnActividad   String   @default("RESPONSABLE")
  estadoAsignacion String   @default("ASIGNADA")
  createdAt        DateTime @default(now())

  actividad Actividad @relation(fields: [actividadId], references: [id])
  usuario   User      @relation(fields: [usuarioId], references: [id])

  @@unique([actividadId, usuarioId])
  @@map("actividades_asignados")
}

model ActividadMaquina {
  id             Int      @id @default(autoincrement())
  actividadId    Int
  maquinaId      Int
  tipoTrabajo    String?
  estadoAtencion String   @default("PENDIENTE")
  observaciones  String?
  porcentaje     Int      @default(0)
  createdAt      DateTime @default(now())

  actividad Actividad @relation(fields: [actividadId], references: [id])
  maquina   Maquina   @relation(fields: [maquinaId], references: [id])

  @@unique([actividadId, maquinaId])
  @@map("actividades_maquinas")
}

model ActividadPaso {
  id               Int       @id @default(autoincrement())
  actividadId      Int
  orden            Int
  tituloPaso       String
  descripcionPaso  String?
  obligatorio      Boolean   @default(true)
  estadoPaso       String    @default("PENDIENTE")
  porcentajePaso   Int       @default(0)
  realizadoPorId   Int?
  fechaRealizacion DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  actividad    Actividad @relation(fields: [actividadId], references: [id])
  realizadoPor User?     @relation("PasoRealizadoPor", fields: [realizadoPorId], references: [id])

  @@map("actividad_pasos")
}

model ActividadMensaje {
  id               Int      @id @default(autoincrement())
  actividadId      Int?
  visitaId         Int?
  usuarioId        Int
  tipoMensaje      String
  asunto           String?
  mensaje          String
  prioridad        String   @default("MEDIA")
  estado           String   @default("NUEVO")
  creadoParaUserId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actividad Actividad? @relation(fields: [actividadId], references: [id])
  visita    Visita?    @relation(fields: [visitaId], references: [id])
  usuario   User       @relation(fields: [usuarioId], references: [id])

  @@map("actividad_mensajes")
}

model Visita {
  id                 Int       @id @default(autoincrement())
  numeroVisita       String?   @unique
  ordenServicioId    Int?
  clienteId          Int
  tecnicoId          Int
  actividadId        Int?
  tipoVisita         String?
  motivoVisita       String?
  resultadoBreve     String?
  estado             String    @default("PENDIENTE")
  motivoEstado       String?
  requiereCotizacion Boolean   @default(false)
  esVisitaLibre      Boolean   @default(false)
  fechaVisita        DateTime  @default(now())
  horaInicio         DateTime?
  horaFin            DateTime?
  observaciones      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ordenServicio OrdenServicio?     @relation(fields: [ordenServicioId], references: [id])
  cliente       Cliente            @relation(fields: [clienteId], references: [id])
  tecnico       User               @relation("VisitaTecnicoPrincipal", fields: [tecnicoId], references: [id])
  actividad     Actividad?         @relation(fields: [actividadId], references: [id])
  maquinas      VisitaMaquina[]
  reportes      Reporte[]
  asignados     VisitaAsignado[]
  mensajes      ActividadMensaje[]

  @@map("visitas")
}

model VisitaAsignado {
  id               Int      @id @default(autoincrement())
  visitaId         Int
  usuarioId        Int
  rolEnVisita      String   @default("RESPONSABLE")
  estadoAsignacion String   @default("ASIGNADA")
  createdAt        DateTime @default(now())

  visita  Visita @relation(fields: [visitaId], references: [id])
  usuario User   @relation(fields: [usuarioId], references: [id])

  @@unique([visitaId, usuarioId])
  @@map("visitas_asignados")
}

model VisitaMaquina {
  id        Int      @id @default(autoincrement())
  visitaId  Int
  maquinaId Int
  createdAt DateTime @default(now())

  visita  Visita  @relation(fields: [visitaId], references: [id])
  maquina Maquina @relation(fields: [maquinaId], references: [id])

  @@unique([visitaId, maquinaId])
  @@map("visitas_maquinas")
}

model Reporte {
  id                 Int      @id @default(autoincrement())
  visitaId           Int
  clienteId          Int
  tecnicoId          Int
  maquinaId          Int?
  tipoUnidadId       Int?
  procedimientoId    Int?
  numeroReporte      String   @unique
  tipoReporte        String?
  conclusiones       String?
  observaciones      String?
  psi                String?
  amperaje           String?
  requiereCotizacion Boolean  @default(false)
  estado             String   @default("borrador")
  urlPdf             String?
  urlCarpetaDrive    String?
  fechaReporte       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  visita        Visita         @relation(fields: [visitaId], references: [id])
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  tecnico       User           @relation(fields: [tecnicoId], references: [id])
  maquina       Maquina?       @relation("ReporteMaquinaCabecera", fields: [maquinaId], references: [id])
  tipoUnidad    TipoUnidad?    @relation(fields: [tipoUnidadId], references: [id])
  procedimiento Procedimiento? @relation(fields: [procedimientoId], references: [id])

  detallesMaquinas ReporteDetalleMaquina[]
  anexos           Anexo[]
  cierre           CierreReporte?

  @@map("reportes")
}

model ReporteDetalleMaquina {
  id                      Int      @id @default(autoincrement())
  reporteId               Int
  maquinaId               Int
  tipoUnidadId            Int?
  procedimientoId         Int?
  procedimiento           String?
  tituloActividad         String?
  descripcionActividadPdf String?
  hallazgosTexto          String?
  diagnostico             String?
  trabajoRealizado        String?
  recomendaciones         String?
  psi                     String?
  amperaje                String?
  observaciones           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  reporte               Reporte        @relation(fields: [reporteId], references: [id])
  maquina               Maquina        @relation(fields: [maquinaId], references: [id])
  tipoUnidad            TipoUnidad?    @relation(fields: [tipoUnidadId], references: [id])
  procedimientoCatalogo Procedimiento? @relation(fields: [procedimientoId], references: [id])

  hallazgos ReporteDetalleHallazgo[]

  @@map("reportes_detalle_maquinas")
}

model ReporteDetalleHallazgo {
  id                      Int      @id @default(autoincrement())
  reporteDetalleMaquinaId Int
  hallazgoCatalogoId      Int
  codigoHallazgo          String?
  descripcionHallazgo     String?
  createdAt               DateTime @default(now())

  reporteDetalleMaquina ReporteDetalleMaquina @relation(fields: [reporteDetalleMaquinaId], references: [id])
  hallazgoCatalogo      HallazgoCatalogo      @relation(fields: [hallazgoCatalogoId], references: [id])

  @@map("reportes_detalle_hallazgos")
}

model Anexo {
  id            Int      @id @default(autoincrement())
  reporteId     Int?
  tipoArchivo   String?
  nombreArchivo String
  urlArchivo    String
  driveFileId   String?
  mimeType      String?
  tamanoBytes   Int?
  createdAt     DateTime @default(now())

  reporte Reporte? @relation(fields: [reporteId], references: [id])

  @@map("anexos")
}

model CierreReporte {
  id                Int      @id @default(autoincrement())
  reporteId         Int      @unique
  recibido          Boolean  @default(false)
  aprobado          Boolean?
  nombreRecibe      String?
  puestoRecibe      String?
  urlFirma          String?
  motivoNoRecepcion String?
  observaciones     String?
  fechaCierre       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reporte Reporte @relation(fields: [reporteId], references: [id])

  @@map("cierres_reporte")
}
